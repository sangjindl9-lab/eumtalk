# 실행 환경: development | staging | production
#  - development/staging: 개발용 테스트 인증(인증번호 000000) 사용 가능
#  - production: 본인확인 사업자 설정이 없으면 신규 가입이 중단된다
APP_ENV=development
PORT=3000

DATABASE_URL=postgres://eumtalk:eumtalk@localhost:5432/eumtalk
DATABASE_SSL=false
# 없으면 서버 1대 기준 메모리 방식으로 동작
REDIS_URL=redis://localhost:6379

# 본인확인 방식: dev(개발·시험 전용) | none | (계약 후 사업자 이름)
IDENTITY_PROVIDER=dev

# 휴대폰 번호 암호화 키(64자리 16진수)와 해시용 비밀값. 운영 환경 필수.
#   생성: openssl rand -hex 32
DATA_KEY=
PHONE_PEPPER=

# 관리자 웹이 서버 상태를 조회할 때 쓰는 값
ADMIN_TOKEN=change-me
# 관리자 웹 주소(쉼표로 여러 개). 비우면 모든 출처 허용(개발용)
CORS_ORIGINS=
