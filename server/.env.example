# 실행 환경: development | staging | production
#  - development/staging: 개발용 테스트 인증(인증번호 000000) 사용 가능
#  - production: 본인확인 사업자 설정이 없으면 신규 가입이 중단된다
APP_ENV=development
PORT=3000

DATABASE_URL=postgres://eumtalk:eumtalk@localhost:5432/eumtalk
DATABASE_SSL=false
# 없으면 서버 1대 기준 메모리 방식으로 동작
REDIS_URL=redis://localhost:6379

# 본인확인 방식: dev(개발·시험 전용) | none | (계약 후 사업자 이름)
IDENTITY_PROVIDER=dev

# 휴대폰 번호 암호화 키(64자리 16진수)와 해시용 비밀값. 운영 환경 필수.
#   생성: openssl rand -hex 32
DATA_KEY=
PHONE_PEPPER=

# 관리자 웹이 서버 상태를 조회할 때 쓰는 값
ADMIN_TOKEN=change-me
# 관리자 웹 주소(쉼표로 여러 개). 비우면 모든 출처 허용(개발용)
CORS_ORIGINS=

# ── 2~5단계 ──────────────────────────────────────────────────────────
# 서버의 외부 주소(사진 링크 생성에 사용). Render에서는 RENDER_EXTERNAL_URL 이 자동으로 쓰인다.
PUBLIC_URL=http://localhost:3000

# 사진 저장소: local(서버 디스크, 개발용) | s3(AWS S3·Cloudflare R2·MinIO 등 S3 호환)
STORAGE_DRIVER=local
MEDIA_DIR=.media
MEDIA_URL_TTL=300
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 푸시: 비우면 발송 기록(push_log)만 남긴다. FCM 서비스 계정 JSON 전체를 한 줄로 넣는다.
PUSH_PROVIDER=
FCM_SERVICE_ACCOUNT=

# 인앱결제 검증: dev(개발·시험, 운영 환경에서는 거부) | live
IAP_MODE=dev
GOOGLE_PLAY_PACKAGE=kr.eumsoft.eumtalk
GOOGLE_SERVICE_ACCOUNT=
APPLE_BUNDLE_ID=kr.eumsoft.eumtalk
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_SANDBOX=true
# Google Play 실시간 개발자 알림(Pub/Sub push) 주소에 붙이는 비밀값: /v1/store/google/notifications?token=...
STORE_WEBHOOK_TOKEN=

# 최초 관리자(소유자) 계정. 비워 두면 관리자 웹 첫 화면에서 ADMIN_TOKEN 으로 만든다.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 추가 금칙어(쉼표 구분)
BLOCKED_WORDS=

# ── 외부 연동 ────────────────────────────────────────────────────────
# 본인확인: IDENTITY_PROVIDER=portone 으로 바꾸고 포트원 관리자 콘솔의 값을 넣는다(본인인증 채널 계약 필요).
PORTONE_STORE_ID=
PORTONE_IDV_CHANNEL_KEY=
PORTONE_API_SECRET=

# 공개 사진(프로필·게시글·방 대표 이미지) 유해성 자동 판별: Google Cloud Vision API 키
GOOGLE_VISION_API_KEY=
